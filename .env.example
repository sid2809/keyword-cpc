# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- App ---------------------------------------------------------------
# Postgres connection string. Local Homebrew default is your macOS username
# with no password: postgresql://$(whoami)@localhost:5432/keyword_cpc
DATABASE_URL=

# Password for the single-user login screen.
APP_PASSWORD=

# Secret used to HMAC-sign the session cookie. Any long random string:
#   openssl rand -base64 36
SESSION_SECRET=

# Keyword count at or below which a run stays on-page ("instant mode").
# Larger runs go to the background runner. Optional; defaults to 2000.
LIVE_MODE_THRESHOLD=2000

# --- Google Ads API ----------------------------------------------------
# From https://ads.google.com/aw/apicenter (API Center on the manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth desktop-app client from Google Cloud Console →
# APIs & Services → Credentials.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token minted for the client above with the
# https://www.googleapis.com/auth/adwords scope.
# NOTE: if the OAuth consent screen is in "Testing" mode, refresh tokens expire
# after 7 days. Publish the app ("In production") for a long-lived token.
# Verify with: npm run check:token
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account ID that the API call authenticates through, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# The account the keyword data is requested under, digits only.
GOOGLE_ADS_CUSTOMER_ID=
