{
  "name": "keyword-cpc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:token": "tsx scripts/check-token.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "scan:secrets": "gitleaks git --staged --redact --no-banner --config .gitleaks.toml",
    "scan:secrets:all": "gitleaks git --redact --no-banner --config .gitleaks.toml",
    "run:keywords": "tsx --conditions=react-server scripts/run-keywords.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "16.3.2",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
